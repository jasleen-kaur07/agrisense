# identity-service environment (all optional unless noted)
PORT=8081
# JDBC URL (required in Compose). The schema comes from currentSchema. SPRING_DATASOURCE_URL/USERNAME/PASSWORD also work.
DATABASE_URL=jdbc:postgresql://postgres:5432/agrisense?currentSchema=identity
DB_USER=identity
DB_PASSWORD=change-me
# PKCS8 PEM RSA private key (literal \n allowed). Empty = ephemeral key generated at startup (dev only).
JWT_PRIVATE_KEY_PEM=
# false only for plain-http local development
COOKIE_SECURE=false
# log = print the password-reset link at INFO (DEV ONLY); anything else logs no link
MAIL_MODE=log
# Dev bootstrap admin, created at startup if both are set and the user does not exist
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
