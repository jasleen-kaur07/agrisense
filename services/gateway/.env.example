# Port the gateway listens on (Dockerfile default 8080)
PORT=8080

# Downstream services (Docker network names in Compose)
IDENTITY_SERVICE_URL=http://identity-service:8081
FARM_ADVISORY_SERVICE_URL=http://farm-advisory-service:8082
DATA_SERVICE_URL=http://data-service:8083

# Identity JWKS (internal URL, never exposed through the gateway)
IDENTITY_JWKS_URL=http://identity-service:8081/.well-known/jwks.json

# Comma separated browser origins allowed for unsafe requests (Origin/Referer check).
# Setting this explicitly also enables CORS with credentials for those origins (dev only).
# Leave empty for same-origin deployment: the Origin check then falls back to http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000
