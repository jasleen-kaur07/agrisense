# Copy to .env for local Docker Compose. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
IDENTITY_DB_PASSWORD=change-me-identity
ADVISORY_DB_PASSWORD=change-me-advisory
DATA_DB_PASSWORD=change-me-data
ML_DB_PASSWORD=change-me-ml
INTERNAL_API_TOKEN=change-me-long-random-internal-token
# Leave empty to generate an ephemeral signing key in dev (sessions reset on restart)
JWT_PRIVATE_KEY_PEM=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_MODEL1=false
MAIL_MODE=log
# Dev-only bootstrap admin (remove for production)
ADMIN_BOOTSTRAP_EMAIL=admin@agrisense.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-pass
